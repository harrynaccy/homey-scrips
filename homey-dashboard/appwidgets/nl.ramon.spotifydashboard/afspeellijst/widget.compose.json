{
  "name": {
    "en": "Spotify – Playlist",
    "nl": "Spotify – Afspeellijst"
  },
  "settings": [
    {
      "id": "height_mode",
      "type": "dropdown",
      "value": "app",
      "title": {
        "en": "Height",
        "nl": "Hoogte"
      },
      "values": [
        {
          "id": "app",
          "title": {
            "en": "Full (app setting)",
            "nl": "Volledig (app-instelling)"
          }
        },
        {
          "id": "percent",
          "title": {
            "en": "Percentage of full height",
            "nl": "Percentage van de volledige hoogte"
          }
        }
      ]
    },
    {
      "id": "height_percent",
      "type": "number",
      "value": 60,
      "min": 20,
      "max": 100,
      "step": 1,
      "title": {
        "en": "Height in % (only with 'Percentage')",
        "nl": "Hoogte in % (alleen bij 'Percentage')"
      }
    },
    {
      "id": "panorama",
      "type": "dropdown",
      "value": "default",
      "title": {
        "en": "Background",
        "nl": "Achtergrond (stuk van de hoes)"
      },
      "values": [
        {
          "id": "default",
          "title": {
            "en": "Standard (quarter 2)",
            "nl": "Standaard (kwart 2)"
          }
        },
        {
          "id": "1",
          "title": {
            "en": "Quarter 1",
            "nl": "Kwart 1"
          }
        },
        {
          "id": "2",
          "title": {
            "en": "Quarter 2",
            "nl": "Kwart 2"
          }
        },
        {
          "id": "3",
          "title": {
            "en": "Quarter 3",
            "nl": "Kwart 3"
          }
        },
        {
          "id": "4",
          "title": {
            "en": "Quarter 4",
            "nl": "Kwart 4"
          }
        },
        {
          "id": "whole",
          "title": {
            "en": "Whole cover",
            "nl": "Hele hoes"
          }
        }
      ]
    },
    {
      "id": "auto_scroll",
      "type": "checkbox",
      "value": true,
      "title": {
        "en": "Scroll along to the current track",
        "nl": "Automatisch meescrollen naar het huidige nummer"
      }
    },
    {
      "id": "tap_to_play",
      "type": "checkbox",
      "value": true,
      "title": {
        "en": "Double-tap a track to play it",
        "nl": "Dubbeltik op een nummer speelt het af"
      }
    },
    {
      "id": "debug",
      "type": "checkbox",
      "value": false,
      "title": {
        "en": "Show diagnostics",
        "nl": "Diagnose tonen"
      }
    }
  ],
  "api": {
    "getState": {
      "method": "GET",
      "path": "/state"
    },
    "getPlaylist": {
      "method": "POST",
      "path": "/playlist"
    },
    "command": {
      "method": "POST",
      "path": "/command"
    }
  }
}
